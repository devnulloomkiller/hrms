@model IEnumerable<Hrms.Domain.Entities.Vacancy>
@using Hrms.Web.Models
@using Hrms.Domain.Entities
@{
    ViewData["Title"] = "Вакансии";
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Вакансии</h1>
        <p class="page-description">Позиции, зарплатные вилки и сроки приёма откликов.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новая вакансия
    </a>
</header>
@if (!Model.Any()) {
    <section class="empty-state">
        <h2>Вакансий пока нет</h2>
        <p>Создайте первую вакансию, чтобы принимать отклики и назначать собеседования.</p>
        <a asp-action="Create" class="btn btn-primary">Создать вакансию</a>
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список вакансий и сроков приёма резюме</caption>
                <thead>
                    <tr><th>Вакансия</th><th>Отдел</th><th>Зарплата</th><th>Статус</th><th>Приём резюме до</th><th class="text-end">Действия</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td data-label="Вакансия">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.Title</a>
                            @if (item.AcceptingResumesUntil is { } until && until >= DateOnly.FromDateTime(DateTime.Today) && item.Status == Hrms.Domain.Entities.VacancyStatus.Open) {
                                var days = until.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                                if (days <= 7) {
                                    <span class="pill pill-@(days <= 3 ? "failed" : "paused") ms-1" title="Приём резюме закрывается">@days дн.</span>
                                }
                            }
                        </td>
                        <td data-label="Отдел" class="text-muted">@item.Department</td>
                        <td data-label="Зарплата" class="font-mono">от @item.SalaryMin.ToString("N0") @(item.SalaryMax is { } max ? $"до {max:N0}" : "")</td>
                        <td data-label="Статус">@Html.Raw(item.Status.Pill())</td>
                        <td data-label="Приём резюме до">@(item.AcceptingResumesUntil?.ToString("dd.MM.yyyy") ?? "Не указан")</td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
