@model IEnumerable<Hrms.Domain.Entities.Candidate>
@using Hrms.Web.Models
@{ ViewData["Title"] = "Кандидаты"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Кандидаты</h1>
        <p class="page-description">Контакты кандидатов и количество их откликов.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новый кандидат
    </a>
</header>
@if (!Model.Any()) {
    <section class="empty-state">
        <h2>Картотека пуста</h2>
        <p>Добавьте кандидата, чтобы связать с ним резюме и собеседования.</p>
        <a asp-action="Create" class="btn btn-primary">Добавить кандидата</a>
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список кандидатов</caption>
                <thead><tr><th>Кандидат</th><th>Email</th><th>Телефон</th><th>Резюме</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                @foreach (var c in Model) {
                    <tr>
                        <td data-label="Кандидат"><a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none fw-semibold">@c.LastName @c.FirstName</a></td>
                        <td data-label="Email" class="text-muted">@c.Email</td>
                        <td data-label="Телефон" class="font-mono">@(c.Phone ?? "Не указан")</td>
                        <td data-label="Резюме">@c.Resumes.Count</td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
