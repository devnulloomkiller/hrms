@model List<Hrms.Application.DTOs.ExpiringVacancyDto>
@{ ViewData["Title"] = "Сроки приёма резюме"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Сроки приёма резюме</h1>
        <p class="page-description">Открытые вакансии, у которых приближается дедлайн откликов.</p>
    </div>
</header>
<partial name="_ReportNavigation" />
<form method="get" class="filter-bar">
    <div class="filter-field">
        <label class="form-label" for="days">Период в днях</label>
        <input id="days" type="number" class="form-control days-input" name="days" value="@ViewBag.Days" min="1" max="90" />
    </div>
    <button type="submit" class="btn btn-outline-primary">Показать вакансии</button>
</form>
@if (Model.Count == 0) {
    <section class="empty-state">
        <h2>Срочных дедлайнов нет</h2>
        <p>В выбранном периоде нет открытых вакансий с завершающимся сроком приёма. Увеличьте период для проверки более поздних дат.</p>
    </section>
} else {
    <div class="card table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle">
                <caption class="visually-hidden">Вакансии с приближающимся сроком приёма резюме</caption>
                <thead><tr><th>Вакансия</th><th>Отдел</th><th>Дедлайн</th><th>Осталось дней</th><th>Резюме</th></tr></thead>
                <tbody>
                @foreach (var v in Model) {
                    <tr class="@(v.DaysLeft <= 3 ? "row-danger" : v.DaysLeft <= 7 ? "row-warning" : "")">
                        <td><a asp-controller="Vacancies" asp-action="Details" asp-route-id="@v.VacancyId" class="text-decoration-none fw-semibold">@v.Title</a></td>
                        <td class="text-muted">@v.Department</td>
                        <td class="font-mono">@v.AcceptingResumesUntil.ToString("dd.MM.yyyy")</td>
                        <td>@v.DaysLeft</td>
                        <td>@v.ResumeCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
