@model IEnumerable<Hrms.Domain.Entities.Resume>
@using Hrms.Web.Models
@{ ViewData["Title"] = "Резюме"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Резюме</h1>
        <p class="page-description">Отклики кандидатов, опыт и текущий этап рассмотрения.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новое резюме
    </a>
</header>
@if (!Model.Any()) {
    <section class="empty-state">
        <h2>Резюме пока нет</h2>
        <p>Добавьте отклик кандидата и при необходимости свяжите его с вакансией.</p>
        <a asp-action="Create" class="btn btn-primary">Добавить резюме</a>
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список резюме кандидатов</caption>
                <thead><tr><th>Кандидат</th><th>Вакансия</th><th>Опыт</th><th>Статус</th><th>Подано</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                @foreach (var r in Model) {
                    <tr>
                        <td data-label="Кандидат"><a asp-controller="Candidates" asp-action="Details" asp-route-id="@r.CandidateId" class="text-decoration-none fw-semibold">@r.Candidate.LastName @r.Candidate.FirstName</a></td>
                        <td data-label="Вакансия" class="text-muted">@(r.Vacancy?.Title ?? "Без вакансии")</td>
                        <td data-label="Опыт">@r.ExperienceYears л.</td>
                        <td data-label="Статус">@Html.Raw(r.Status.Pill())</td>
                        <td data-label="Подано">@r.SubmittedAt.ToString("dd.MM.yyyy")</td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
