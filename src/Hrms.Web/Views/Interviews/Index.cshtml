@model IEnumerable<Hrms.Domain.Entities.Interview>
@using Hrms.Web.Models
@{ ViewData["Title"] = "Собеседования"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Собеседования</h1>
        <p class="page-description">Расписание встреч, участники и итоги по каждому кандидату.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Назначить собеседование
    </a>
</header>
@if (!Model.Any()) {
    <section class="empty-state">
        <h2>Собеседования не назначены</h2>
        <p>Выберите резюме и вакансию, затем укажите дату и участников встречи.</p>
        <a asp-action="Create" class="btn btn-primary">Назначить собеседование</a>
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Расписание собеседований</caption>
                <thead><tr><th>Дата</th><th>Кандидат</th><th>Вакансия</th><th>Формат</th><th>Итог</th><th>Участники</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                @foreach (var i in Model) {
                    <tr>
                        <td data-label="Дата" class="font-mono text-nowrap">@i.ScheduledAt.ToString("dd.MM HH:mm")</td>
                        <td data-label="Кандидат"><a asp-controller="Candidates" asp-action="Details" asp-route-id="@i.Resume.CandidateId" class="text-decoration-none fw-semibold">@i.Resume.Candidate.LastName @i.Resume.Candidate.FirstName</a></td>
                        <td data-label="Вакансия" class="text-muted">@i.Vacancy.Title</td>
                        <td data-label="Формат">@Html.Raw(i.Mode.Pill())</td>
                        <td data-label="Итог">@Html.Raw(i.Result.Pill())</td>
                        <td data-label="Участники" class="text-muted small">@string.Join(", ", i.Participants.Select(p => p.Interviewer.FullName))</td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@i.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
