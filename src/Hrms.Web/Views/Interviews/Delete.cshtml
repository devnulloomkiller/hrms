@model Hrms.Domain.Entities.Interview
@{ ViewData["Title"] = $"Удалить собеседование #{Model.Id}"; }
<header class="page-header">
    <div class="page-header-copy"><h1 class="page-title">Удалить собеседование</h1></div>
</header>
<div class="card delete-card">
    <h2>Удалить собеседование с кандидатом @Model.Resume.Candidate.LastName @Model.Resume.Candidate.FirstName по вакансии «@Model.Vacancy.Title», назначенное на @Model.ScheduledAt.ToString("dd.MM.yyyy HH:mm")?</h2>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Удалить собеседование</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </form>
</div>
