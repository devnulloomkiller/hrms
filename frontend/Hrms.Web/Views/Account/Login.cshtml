@model (string email, bool rememberMe, string? returnUrl)?
@{ ViewData["Title"] = "Вход"; }
<div class="auth-shell">
    <div class="card">
        <div class="card-body">
            <p class="section-label">Личный кабинет</p>
            <h1>Вход в HRMS</h1>
            <p class="text-muted mb-4">Введите данные своей учётной записи.</p>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-control" id="email" name="email" type="email" value="@Model?.email" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Пароль</label>
                    <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" name="rememberMe" value="true" @(Model?.rememberMe == true ? "checked" : "") id="rm" />
                    <label class="form-check-label" for="rm">Запомнить меня</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Войти в систему</button>
            </form>
            <p class="text-center mt-4 mb-0">Нет учётной записи? <a asp-action="Register">Зарегистрироваться</a></p>
        </div>
    </div>
    <p class="auth-note">Демо-доступ: admin@hrms.local, пароль Admin123</p>
</div>
