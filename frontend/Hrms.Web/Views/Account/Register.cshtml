@{ ViewData["Title"] = "Регистрация"; }
<div class="auth-shell">
    <div class="card">
        <div class="card-body">
            <p class="section-label">Доступ для сотрудника</p>
            <h1>Регистрация</h1>
            <p class="text-muted mb-4">Новая учётная запись получит роль HR.</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" for="displayName">Имя</label>
                    <input class="form-control" id="displayName" name="displayName" autocomplete="name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="register-email">Email</label>
                    <input class="form-control" id="register-email" name="email" type="email" autocomplete="username" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="register-password">Пароль</label>
                    <input class="form-control" id="register-password" name="password" type="password" autocomplete="new-password" minlength="6" required />
                    <div class="form-text text-muted">Не меньше 6 символов.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Создать учётную запись</button>
            </form>
            <p class="text-center mt-4 mb-0">Уже зарегистрированы? <a asp-action="Login">Войти</a></p>
        </div>
    </div>
</div>
