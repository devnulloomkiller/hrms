<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HRMS: вакансии, кандидаты, резюме и собеседования в одной системе кадрового учёта." />
    <title>@ViewData["Title"] · HRMS</title>
    <script>
        try {
            const savedTheme = localStorage.getItem("hrms-theme");
            document.documentElement.dataset.theme = savedTheme || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch {
            document.documentElement.dataset.theme = "light";
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hrms.Web.styles.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Перейти к содержимому</a>
<div class="page-progress" id="page-progress" role="status" aria-label="Загрузка страницы" aria-hidden="true"><span></span></div>
@if (User.Identity?.IsAuthenticated == true) {
    var userInitial = User.Identity?.Name is { Length: > 0 } name ? name[0].ToString().ToUpperInvariant() : "U";
    <div class="app-shell">
        <aside class="app-sidebar d-none d-lg-flex">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" aria-label="HRMS, на главную">
                <span class="brand-mark">HR</span>
                <span><strong>HRMS</strong><small>Кадровый учёт</small></span>
            </a>
            <partial name="_Navigation" />
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="user-avatar" aria-hidden="true">@userInitial</span>
                    <span class="user-copy"><strong>@User.Identity?.Name</strong><small>Рабочий аккаунт</small></span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-logout" aria-label="Выйти из учётной записи" title="Выйти">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>
        <div class="app-workspace">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="topbar-icon-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Открыть меню">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                    </button>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="topbar-actions">
                    <button type="button" class="theme-toggle" aria-pressed="false">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16"/></svg>
                        <span class="theme-toggle-label">Тёмная тема</span>
                    </button>
                    <a asp-controller="Vacancies" asp-action="Create" class="btn btn-sm btn-primary topbar-create">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        Новая вакансия
                    </a>
                </div>
            </header>
            <main class="app-main" id="main-content" tabindex="-1">
                <div class="app-container">
                    @if (TempData["StatusMessage"] is string statusMessage)
                    {
                        <div class="flash-message" role="status">@statusMessage</div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="flash-message flash-message-error" role="alert">@errorMessage</div>
                    }
                    @RenderBody()
                </div>
            </main>
            <footer class="app-footer">
                <div class="app-container"><span>HRMS</span><span>Учебная система кадрового учёта</span></div>
            </footer>
        </div>
    </div>
    <div class="offcanvas offcanvas-start sidebar-offcanvas" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="mobileMenuLabel">Меню HRMS</h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="offcanvas">Закрыть</button>
        </div>
        <div class="offcanvas-body">
            <partial name="_Navigation" />
            <div class="mobile-account">
                <span class="text-muted small">Вы вошли как</span>
                <strong class="mobile-user">@User.Identity?.Name</strong>
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-secondary w-100">Выйти</button></form>
            </div>
        </div>
    </div>
} else {
    <div class="auth-page">
        <header class="auth-page-header">
            <a class="auth-brand" asp-controller="Account" asp-action="Login" aria-label="HRMS, на страницу входа">
                <span class="brand-mark">HR</span>
                <span><strong>HRMS</strong><small>Кадровый учёт</small></span>
            </a>
            <button type="button" class="theme-toggle" aria-pressed="false">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16"/></svg>
                <span class="theme-toggle-label">Тёмная тема</span>
            </button>
        </header>
        <main class="auth-page-main" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
        <footer class="auth-page-footer"><span>HRMS</span><span>Учебная система кадрового учёта</span></footer>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
