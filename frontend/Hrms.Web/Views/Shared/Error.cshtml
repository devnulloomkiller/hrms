@model ErrorViewModel
@{ ViewData["Title"] = "Ошибка"; }
<section class="empty-state" aria-labelledby="error-title">
    <p class="section-label">Не удалось завершить запрос</p>
    <h1 id="error-title">Что-то пошло не так</h1>
    <p class="mt-3">Повторите действие. Если ошибка возникнет снова, передайте разработчику идентификатор запроса.</p>
    @if (Model.ShowRequestId) {
        <p><strong>Идентификатор запроса:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Вернуться на главную</a>
</section>
