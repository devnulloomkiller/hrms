@model Hrms.Domain.Entities.Vacancy
@{ ViewData["Title"] = $"Изменить: {Model.Title}"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Изменить вакансию</h1>
        <p class="page-description">@Model.Title</p>
    </div>
</header>
<div class="card form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_FormFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
