@model Hrms.Domain.Entities.Vacancy
@{ ViewData["Title"] = "Новая вакансия"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Новая вакансия</h1>
        <p class="page-description">Укажите условия позиции, требования и срок приёма откликов.</p>
    </div>
</header>
<div class="card form-card">
    <form asp-action="Create" method="post">
        <partial name="_FormFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Создать вакансию</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
