@model IEnumerable<Hrms.Domain.Entities.Vacancy>
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = "Вакансии";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var status = ViewBag.Status as VacancyStatus?;
    var hasFilters = !string.IsNullOrWhiteSpace(ViewBag.Search as string) || status is not null || ViewBag.OnlyAccepting == true;
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Вакансии</h1>
        <p class="page-description">Позиции, условия, дедлайны и воронка откликов по каждой вакансии.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новая вакансия
    </a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр вакансий">
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="vacancy-search">Поиск</label>
        <input id="vacancy-search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Название или отдел" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="vacancy-status">Статус</label>
        <select id="vacancy-status" name="status" class="form-select">
            <option value="">Все статусы</option>
            @foreach (var value in Enum.GetValues<VacancyStatus>()) {
                <option value="@value" selected="@(status == value)">@value.Ru()</option>
            }
        </select>
    </div>
    <label class="filter-check">
        <input type="checkbox" name="onlyAccepting" value="true" checked="@(ViewBag.OnlyAccepting == true)" />
        Приём резюме открыт
    </label>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (!Model.Any()) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>По фильтру ничего не нашлось</h2>
            <p>Попробуйте выбрать другой статус или снять условие по сроку приёма резюме.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Вакансий пока нет</h2>
            <p>Создайте первую вакансию, чтобы принимать отклики и подбирать резюме.</p>
            <a asp-action="Create" class="btn btn-primary">Создать вакансию</a>
        }
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список вакансий</caption>
                <thead>
                    <tr><th>Вакансия</th><th>Условия</th><th>Зарплата</th><th>Статус</th><th>Дедлайн</th><th>Воронка</th><th class="text-end">Действия</th></tr>
                </thead>
                <tbody>
                @foreach (var vacancy in Model) {
                    var active = vacancy.Applications.Count(a => a.Stage is ApplicationStage.Applied or ApplicationStage.Screening or ApplicationStage.Interview or ApplicationStage.Offer);
                    <tr>
                        <td data-label="Вакансия">
                            <a asp-action="Details" asp-route-id="@vacancy.Id" class="text-decoration-none fw-semibold">@vacancy.Title</a>
                            <span class="table-subtext">@vacancy.Department</span>
                        </td>
                        <td data-label="Условия">
                            <span>от @vacancy.MinExperience л. опыта</span>
                            @if (!string.IsNullOrWhiteSpace(vacancy.RequiredSkills)) {
                                <span class="table-subtext skill-text" title="@vacancy.RequiredSkills">@vacancy.RequiredSkills</span>
                            }
                        </td>
                        <td data-label="Зарплата" class="font-mono text-nowrap">@vacancy.SalaryMin.ToString("N0")–@(vacancy.SalaryMax?.ToString("N0") ?? "…") ₽</td>
                        <td data-label="Статус">@Html.Raw(vacancy.Status.Pill())</td>
                        <td data-label="Дедлайн">
                            @if (vacancy.AcceptingResumesUntil is { } until) {
                                <span class="font-mono">@until.ToString("dd.MM.yyyy")</span>
                                if (vacancy.Status == VacancyStatus.Open && until >= today) {
                                    var days = until.DayNumber - today.DayNumber;
                                    if (days <= 7) {
                                        <span class="deadline-badge @(days <= 3 ? "deadline-urgent" : "")">@days дн.</span>
                                    }
                                }
                            } else {
                                <span class="text-muted">Без срока</span>
                            }
                        </td>
                        <td data-label="Воронка">
                            <span>@vacancy.Applications.Count откл.</span>
                            <span class="table-subtext">@active в работе · @vacancy.ResumeMatches.Count в подборе</span>
                        </td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@vacancy.Id" class="btn btn-sm btn-outline-secondary">Открыть</a>
                            <a asp-action="Edit" asp-route-id="@vacancy.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
