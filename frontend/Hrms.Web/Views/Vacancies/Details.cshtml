@model Hrms.Domain.Entities.Vacancy
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = $"Вакансия: {Model.Title}";
    var activeCount = Model.Applications.Count(a => a.Stage is ApplicationStage.Applied or ApplicationStage.Screening or ApplicationStage.Interview or ApplicationStage.Offer);
    var interviewCount = Model.Applications.Sum(a => a.Interviews.Count);
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<header class="page-header">
    <div class="page-header-copy">
        <p class="section-label">Вакансия</p>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-description">@Model.Department · @Html.Raw(Model.Status.Pill())</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Изменить</a>
        <a asp-action="Match" asp-route-id="@Model.Id" class="btn btn-outline-primary">Подобрать резюме</a>
        <a asp-controller="Applications" asp-action="Create" asp-route-vacancyId="@Model.Id" class="btn btn-primary">Добавить отклик</a>
    </div>
</header>

<section class="stat-strip" aria-label="Сводка по вакансии">
    <div class="stat-item"><span>Всего откликов</span><strong>@Model.Applications.Count</strong></div>
    <div class="stat-item"><span>В работе</span><strong>@activeCount</strong></div>
    <div class="stat-item"><span>Собеседования</span><strong>@interviewCount</strong></div>
    <div class="stat-item"><span>В подборе</span><strong>@Model.ResumeMatches.Count</strong></div>
</section>

<div class="row g-3">
    <div class="col-lg-5">
        <section class="card detail-card h-100" aria-labelledby="vacancy-conditions">
            <h2 id="vacancy-conditions">Условия</h2>
            <dl class="detail-list">
                <dt>Зарплата</dt>
                <dd class="font-mono">@Model.SalaryMin.ToString("N0")–@(Model.SalaryMax?.ToString("N0") ?? "…") ₽</dd>
                <dt>Опыт</dt><dd>от @Model.MinExperience лет</dd>
                <dt>Навыки</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.RequiredSkills) ? "Не указаны" : Model.RequiredSkills)</dd>
                <dt>Опубликована</dt><dd>@Model.PublishedAt.ToString("dd.MM.yyyy")</dd>
                <dt>Приём резюме</dt>
                <dd>
                    @if (Model.AcceptingResumesUntil is { } until) {
                        <span>@until.ToString("dd.MM.yyyy")</span>
                        @if (until >= today && Model.Status == VacancyStatus.Open) {
                            <span class="deadline-badge @(until.DayNumber - today.DayNumber <= 3 ? "deadline-urgent" : "")">@(until.DayNumber - today.DayNumber) дн.</span>
                        }
                    } else {
                        <span class="text-muted">Без срока</span>
                    }
                </dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="card detail-card h-100" aria-labelledby="vacancy-description">
            <h2 id="vacancy-description">Описание</h2>
            @if (string.IsNullOrWhiteSpace(Model.Description)) {
                <p class="text-muted mb-0">Описание не добавлено.</p>
            } else {
                <p class="mb-0">@Model.Description</p>
            }
        </section>
    </div>
</div>

<section class="mt-4" aria-labelledby="vacancy-applications">
    <div class="section-heading-row">
        <div>
            <h2 id="vacancy-applications">Отклики</h2>
            <p class="page-description">Кандидаты, которые откликнулись на эту вакансию, и их этап.</p>
        </div>
        <a asp-controller="Applications" asp-action="Create" asp-route-vacancyId="@Model.Id" class="btn btn-outline-secondary">Добавить отклик</a>
    </div>
    @if (Model.Applications.Count == 0) {
        <div class="empty-state mt-3">
            <h3>Откликов пока нет</h3>
            <p>Добавьте отклик вручную или подберите резюме по требованиям вакансии.</p>
            <a asp-action="Match" asp-route-id="@Model.Id" class="btn btn-primary">Подобрать резюме</a>
        </div>
    } else {
        <div class="card table-card responsive-table-card mt-3">
            <div class="table-wrap">
                <table class="table table-hover align-middle responsive-table">
                    <caption class="visually-hidden">Отклики на вакансию @Model.Title</caption>
                    <thead><tr><th>Кандидат</th><th>Этап</th><th>Дата отклика</th><th>Собеседования</th><th class="text-end">Действия</th></tr></thead>
                    <tbody>
                    @foreach (var application in Model.Applications.OrderByDescending(a => a.AppliedAt)) {
                        <tr>
                            <td data-label="Кандидат">
                                <a asp-controller="Candidates" asp-action="Details" asp-route-id="@application.CandidateId" class="text-decoration-none fw-semibold">@application.Candidate.LastName @application.Candidate.FirstName</a>
                                <span class="table-subtext">@(application.Candidate.Resume?.Headline ?? "Резюме не заполнено")</span>
                            </td>
                            <td data-label="Этап">@Html.Raw(application.Stage.Pill())</td>
                            <td data-label="Дата отклика" class="font-mono text-nowrap">@application.AppliedAt.ToString("dd.MM.yyyy")</td>
                            <td data-label="Собеседования">@application.Interviews.Count</td>
                            <td data-label="Действия" class="text-end text-nowrap">
                                <a asp-controller="Applications" asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<section class="mt-4" aria-labelledby="vacancy-matches">
    <div class="section-heading-row">
        <div>
            <h2 id="vacancy-matches">Подборка резюме</h2>
            <p class="page-description">Резюме, связанные с вакансией по фильтрам. Оценка показывает соответствие требованиям.</p>
        </div>
        <a asp-action="Match" asp-route-id="@Model.Id" class="btn btn-outline-primary">Подобрать ещё</a>
    </div>
    @if (Model.ResumeMatches.Count == 0) {
        <div class="empty-state mt-3">
            <h3>В подборке пусто</h3>
            <p>Запустите подбор по опыту, навыкам и зарплатным ожиданиям — подходящие резюме появятся здесь.</p>
            <a asp-action="Match" asp-route-id="@Model.Id" class="btn btn-primary">Подобрать резюме</a>
        </div>
    } else {
        <div class="card table-card responsive-table-card mt-3">
            <div class="table-wrap">
                <table class="table table-hover align-middle responsive-table">
                    <caption class="visually-hidden">Подобранные резюме для вакансии @Model.Title</caption>
                    <thead><tr><th>Кандидат</th><th>Опыт</th><th>Соответствие</th><th>Статус подбора</th><th class="text-end">Действия</th></tr></thead>
                    <tbody>
                    @foreach (var match in Model.ResumeMatches.OrderByDescending(m => m.MatchScore)) {
                        <tr>
                            <td data-label="Кандидат">
                                <a asp-controller="Candidates" asp-action="Details" asp-route-id="@match.Resume.CandidateId" class="text-decoration-none fw-semibold">@match.Resume.Candidate.LastName @match.Resume.Candidate.FirstName</a>
                                <span class="table-subtext">@match.Resume.Headline</span>
                            </td>
                            <td data-label="Опыт">@match.Resume.ExperienceYears л.</td>
                            <td data-label="Соответствие">
                                <div class="score-cell">
                                    <span class="score">@(match.MatchScore ?? 0)%</span>
                                    <span class="score-meter" aria-hidden="true"><span style="width:@(match.MatchScore ?? 0)%"></span></span>
                                </div>
                            </td>
                            <td data-label="Статус подбора">
                                <form asp-action="UpdateMatchStatus" method="post" class="inline-form">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="resumeId" value="@match.ResumeId" />
                                    <label class="visually-hidden" for="match-status-@match.ResumeId">Статус подбора для @match.Resume.Candidate.LastName</label>
                                    <select id="match-status-@match.ResumeId" name="status" class="form-select form-select-sm">
                                        @foreach (var value in Enum.GetValues<MatchStatus>()) {
                                            <option value="@value" selected="@(match.Status == value)">@value.Ru()</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">ОК</button>
                                </form>
                            </td>
                            <td data-label="Действия" class="text-end text-nowrap">
                                <form asp-action="Unlink" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="resumeId" value="@match.ResumeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Убрать</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<div class="form-actions form-actions-between">
    <a asp-action="Index" class="btn btn-outline-secondary">Вернуться к вакансиям</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Удалить вакансию</a>
</div>
