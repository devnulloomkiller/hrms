@model Hrms.Domain.Entities.Vacancy
@{ ViewData["Title"] = $"Вакансия: {Model.Title}"; }
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-description">@Model.Department</p>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить вакансию</a>
</header>
<div class="card detail-card">
    <dl class="row g-3">
        <dt class="col-sm-3">Отдел</dt><dd class="col-sm-9">@Model.Department</dd>
        <dt class="col-sm-3">Зарплата</dt><dd class="col-sm-9 font-mono">от @Model.SalaryMin.ToString("N0") @(Model.SalaryMax is { } max ? $"до {max:N0}" : "")</dd>
        <dt class="col-sm-3">Статус</dt><dd class="col-sm-9">@Html.Raw(Model.Status.Pill())</dd>
        <dt class="col-sm-3">Опубликовано</dt><dd class="col-sm-9">@Model.PublishedAt.ToString("dd.MM.yyyy")</dd>
        <dt class="col-sm-3">Приём резюме до</dt><dd class="col-sm-9">@(Model.AcceptingResumesUntil?.ToString("dd.MM.yyyy") ?? "Не указан")</dd>
        <dt class="col-sm-3">Описание</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "Описание не добавлено" : Model.Description)</dd>
    </dl>
</div>
<div class="form-actions">
    <a asp-action="Index" class="btn btn-outline-secondary">Вернуться к вакансиям</a>
</div>
