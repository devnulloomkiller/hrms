@model ApplicationBoardViewModel
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = "Отклики";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.VacancyId is not null || Model.Stage is not null;
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Отклики</h1>
        <p class="page-description">Воронка найма: от нового отклика до оффера и найма.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новый отклик
    </a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр откликов">
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="application-search">Поиск</label>
        <input id="application-search" name="search" value="@Model.Search" class="form-control" placeholder="Кандидат, email или вакансия" />
    </div>
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="application-vacancy">Вакансия</label>
        <select id="application-vacancy" name="vacancyId" class="form-select">
            <option value="">Все вакансии</option>
            @foreach (var vacancy in Model.Vacancies) {
                <option value="@vacancy.Id" selected="@(Model.VacancyId == vacancy.Id)">@vacancy.Title · @vacancy.Department</option>
            }
        </select>
    </div>
    <div class="filter-field">
        <label class="form-label" for="application-stage">Этап</label>
        <select id="application-stage" name="stage" class="form-select">
            <option value="">Все этапы</option>
            @foreach (var stage in Enum.GetValues<ApplicationStage>()) {
                <option value="@stage" selected="@(Model.Stage == stage)">@stage.Ru()</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (Model.TotalCount == 0) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>По фильтру откликов не нашлось</h2>
            <p>Попробуйте выбрать другую вакансию или сбросить этап.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Откликов пока нет</h2>
            <p>Создайте первый отклик: выберите кандидата с резюме и вакансию.</p>
            <a asp-action="Create" class="btn btn-primary">Добавить отклик</a>
        }
    </section>
} else {
    <div class="pipeline-board" role="list" aria-label="Воронка откликов по этапам">
        @foreach (var column in Model.Columns) {
            <section class="pipeline-column" role="listitem" aria-labelledby="stage-@column.Stage">
                <header class="pipeline-column-header">
                    <h2 id="stage-@column.Stage">@column.Title</h2>
                    <span class="pipeline-count">@column.Items.Count</span>
                </header>
                @if (column.Items.Count == 0) {
                    <p class="pipeline-empty">На этом этапе пока пусто.</p>
                } else {
                    <div class="pipeline-cards">
                        @foreach (var application in column.Items) {
                            <article class="pipeline-card">
                                <a class="pipeline-card-name" asp-controller="Candidates" asp-action="Details" asp-route-id="@application.CandidateId">@application.Candidate.LastName @application.Candidate.FirstName</a>
                                <a class="pipeline-card-vacancy" asp-controller="Vacancies" asp-action="Details" asp-route-id="@application.VacancyId">@application.Vacancy.Title</a>
                                <p class="pipeline-card-meta">
                                    <span>@application.Candidate.Resume?.ExperienceYears л. опыта</span>
                                    <span>@application.AppliedAt.ToString("dd.MM.yyyy")</span>
                                </p>
                                <p class="pipeline-card-meta">
                                    <span>@(application.Interviews.Count == 0 ? "Без собеседований" : $"Собеседований: {application.Interviews.Count}")</span>
                                </p>
                                <a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Открыть отклик</a>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>

    @if (Model.ClosedApplications.Count > 0) {
        <details class="closed-applications">
            <summary>Закрытые отклики: @Model.ClosedApplications.Count</summary>
            <div class="card table-card mt-3">
                <div class="table-wrap">
                    <table class="table table-hover align-middle">
                        <caption class="visually-hidden">Отклонённые и отозванные отклики</caption>
                        <thead><tr><th>Кандидат</th><th>Вакансия</th><th>Этап</th><th>Дата</th><th class="text-end">Действия</th></tr></thead>
                        <tbody>
                        @foreach (var application in Model.ClosedApplications) {
                            <tr>
                                <td><a asp-controller="Candidates" asp-action="Details" asp-route-id="@application.CandidateId" class="text-decoration-none fw-semibold">@application.Candidate.LastName @application.Candidate.FirstName</a></td>
                                <td><a asp-controller="Vacancies" asp-action="Details" asp-route-id="@application.VacancyId" class="text-decoration-none">@application.Vacancy.Title</a></td>
                                <td>@Html.Raw(application.Stage.Pill())</td>
                                <td class="font-mono">@application.AppliedAt.ToString("dd.MM.yyyy")</td>
                                <td class="text-end"><a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Изменить</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }
}
