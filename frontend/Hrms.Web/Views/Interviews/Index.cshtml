@model IEnumerable<Hrms.Domain.Entities.Interview>
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = "Собеседования";
    var vacancies = ViewBag.Vacancies as List<Hrms.Application.DTOs.VacancyOptionDto> ?? [];
    var upcoming = ViewBag.Upcoming as bool?;
    var result = ViewBag.Result as InterviewResult?;
    var vacancyId = ViewBag.VacancyId as int?;
    var hasFilters = upcoming is not null || result is not null || vacancyId is not null;
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Собеседования</h1>
        <p class="page-description">Расписание встреч, участники и итоги по каждому отклику.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Назначить собеседование
    </a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр собеседований">
    <div class="filter-field">
        <label class="form-label" for="interview-when">Когда</label>
        <select id="interview-when" name="upcoming" class="form-select">
            <option value="">Все встречи</option>
            <option value="true" selected="@(upcoming == true)">Предстоящие</option>
            <option value="false" selected="@(upcoming == false)">Прошедшие</option>
        </select>
    </div>
    <div class="filter-field">
        <label class="form-label" for="interview-result">Итог</label>
        <select id="interview-result" name="result" class="form-select">
            <option value="">Любой итог</option>
            @foreach (var value in Enum.GetValues<InterviewResult>()) {
                <option value="@value" selected="@(result == value)">@value.Ru()</option>
            }
        </select>
    </div>
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="interview-vacancy">Вакансия</label>
        <select id="interview-vacancy" name="vacancyId" class="form-select">
            <option value="">Все вакансии</option>
            @foreach (var vacancy in vacancies) {
                <option value="@vacancy.Id" selected="@(vacancyId == vacancy.Id)">@vacancy.Title · @vacancy.Department</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (!Model.Any()) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>По фильтру встреч не нашлось</h2>
            <p>Сбросьте фильтры или измените период — возможно, встреча уже прошла.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Собеседования не назначены</h2>
            <p>Выберите отклик, укажите дату и участников — этап отклика автоматически станет «Собеседование».</p>
            <a asp-action="Create" class="btn btn-primary">Назначить собеседование</a>
        }
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Расписание собеседований</caption>
                <thead><tr><th>Дата</th><th>Кандидат</th><th>Вакансия</th><th>Этап</th><th>Формат</th><th>Итог</th><th>Участники</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                @foreach (var interview in Model) {
                    <tr>
                        <td data-label="Дата" class="font-mono text-nowrap">@interview.ScheduledAt.ToString("dd.MM HH:mm")</td>
                        <td data-label="Кандидат">
                            <a asp-controller="Candidates" asp-action="Details" asp-route-id="@interview.Application.CandidateId" class="text-decoration-none fw-semibold">@interview.Application.Candidate.LastName @interview.Application.Candidate.FirstName</a>
                        </td>
                        <td data-label="Вакансия" class="text-muted">@interview.Application.Vacancy.Title</td>
                        <td data-label="Этап">@Html.Raw(interview.Application.Stage.Pill())</td>
                        <td data-label="Формат">@Html.Raw(interview.Mode.Pill())</td>
                        <td data-label="Итог">@Html.Raw(interview.Result.Pill())</td>
                        <td data-label="Участники" class="text-muted small">@string.Join(", ", interview.Participants.Select(p => p.Interviewer.FullName))</td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@interview.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@interview.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
