@model Hrms.Domain.Entities.Interview
@{
    ViewData["Title"] = $"Собеседование #{Model.Id}";
}
<header class="page-header">
    <div class="page-header-copy">
        <p class="section-label">Собеседование</p>
        <h1 class="page-title">@Model.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</h1>
        <p class="page-description">@Model.Application.Candidate.LastName @Model.Application.Candidate.FirstName · @Model.Application.Vacancy.Title</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Изменить</a>
        <a asp-controller="Applications" asp-action="Edit" asp-route-id="@Model.ApplicationId" class="btn btn-outline-primary">Открыть отклик</a>
    </div>
</header>
<div class="card detail-card">
    <dl class="detail-list">
        <dt>Кандидат</dt>
        <dd><a asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.Application.CandidateId">@Model.Application.Candidate.LastName @Model.Application.Candidate.FirstName</a></dd>
        <dt>Вакансия</dt>
        <dd><a asp-controller="Vacancies" asp-action="Details" asp-route-id="@Model.Application.VacancyId">@Model.Application.Vacancy.Title</a></dd>
        <dt>Этап отклика</dt><dd>@Html.Raw(Model.Application.Stage.Pill())</dd>
        <dt>Формат</dt><dd>@Html.Raw(Model.Mode.Pill())</dd>
        <dt>Итог</dt><dd>@Html.Raw(Model.Result.Pill())</dd>
    </dl>
</div>
<section class="mt-4" aria-labelledby="interview-participants">
    <h2 id="interview-participants">Участники</h2>
    @if (Model.Participants.Count == 0) {
        <p class="text-muted">Участники не назначены.</p>
    } else {
        <ul class="participant-list">
        @foreach (var participant in Model.Participants) {
            <li><strong>@participant.Interviewer.FullName</strong><span>@participant.Role, @participant.Interviewer.Position</span></li>
        }
        </ul>
    }
</section>
@if (!string.IsNullOrEmpty(Model.Notes)) {
    <section class="mt-4" aria-labelledby="interview-notes">
        <h2 id="interview-notes">Заметки</h2>
        <p class="mb-0">@Model.Notes</p>
    </section>
}
<div class="form-actions">
    <a asp-action="Index" class="btn btn-outline-secondary">Вернуться к расписанию</a>
</div>
