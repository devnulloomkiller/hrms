@model DashboardViewModel
@using Hrms.Domain.Entities
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = isAuthenticated ? "Обзор найма" : "Главная";
}
@if (isAuthenticated) {
    <header class="dashboard-header">
        <div>
            <p class="section-label">Рабочий стол</p>
            <h1>Обзор найма</h1>
            <p class="page-description">Актуальные вакансии, отклики и ближайшие собеседования.</p>
        </div>
        <div class="dashboard-header-actions">
            <a asp-controller="Candidates" asp-action="Create" class="btn btn-outline-secondary">Добавить кандидата</a>
            <a asp-controller="Vacancies" asp-action="Create" class="btn btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Новая вакансия
            </a>
        </div>
    </header>
    <section class="metric-strip" aria-label="Показатели найма">
        <a class="metric-item" asp-controller="Vacancies" asp-action="Index">
            <span class="metric-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg></span>
            <span class="metric-copy"><span>Открытые вакансии</span><strong>@Model.OpenVacancies</strong></span>
            <span class="metric-link">Список</span>
        </a>
        <a class="metric-item" asp-controller="Candidates" asp-action="Index">
            <span class="metric-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v2"/></svg></span>
            <span class="metric-copy"><span>Кандидаты</span><strong>@Model.TotalCandidates</strong></span>
            <span class="metric-link">Картотека</span>
        </a>
        <a class="metric-item" asp-controller="Resumes" asp-action="Index">
            <span class="metric-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span>
            <span class="metric-copy"><span>Активные резюме</span><strong>@Model.ActiveResumes</strong></span>
            <span class="metric-link">В работе</span>
        </a>
        <a class="metric-item" asp-controller="Interviews" asp-action="Index">
            <span class="metric-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M8 15h3"/></svg></span>
            <span class="metric-copy"><span>Предстоящие собеседования</span><strong>@Model.UpcomingInterviewsCount</strong></span>
            <span class="metric-link">Расписание</span>
        </a>
    </section>
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="upcoming-title">
            <div class="panel-header">
                <div><p class="panel-kicker">Расписание</p><h2 id="upcoming-title">Ближайшие собеседования</h2></div>
                <a asp-controller="Interviews" asp-action="Index" class="panel-link">Все собеседования</a>
            </div>
            @if (Model.UpcomingInterviews.Count == 0) {
                <div class="panel-empty">
                    <h3>Предстоящих встреч нет</h3>
                    <p>Назначьте собеседование по резюме кандидата.</p>
                    <a asp-controller="Interviews" asp-action="Create" class="btn btn-outline-primary">Назначить встречу</a>
                </div>
            } else {
                <div class="schedule-list">
                @foreach (var interview in Model.UpcomingInterviews) {
                    <a class="schedule-row" asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id">
                        <time class="schedule-date" datetime="@interview.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")">
                            <strong>@interview.ScheduledAt.ToString("dd.MM")</strong>
                            <span>@interview.ScheduledAt.ToString("HH:mm")</span>
                        </time>
                        <span class="schedule-person">
                            <strong>@interview.Resume.Candidate.LastName @interview.Resume.Candidate.FirstName</strong>
                            <span>@interview.Vacancy.Title</span>
                        </span>
                        <span class="schedule-mode">@Html.Raw(interview.Mode.Pill())</span>
                        <svg class="row-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                }
                </div>
            }
        </section>
        <aside class="dashboard-side">
            <section class="panel" aria-labelledby="deadlines-title">
                <div class="panel-header">
                    <div><p class="panel-kicker">На этой неделе</p><h2 id="deadlines-title">Дедлайны приёма</h2></div>
                    <a asp-controller="Reports" asp-action="ExpiringVacancies" class="panel-link" aria-label="Открыть отчёт по дедлайнам">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                </div>
                @if (Model.ExpiringVacancies.Count == 0) {
                    <div class="panel-empty compact"><p>На ближайшие 7 дней дедлайнов нет.</p></div>
                } else {
                    <div class="deadline-list">
                    @foreach (var vacancy in Model.ExpiringVacancies) {
                        var days = vacancy.AcceptingResumesUntil!.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                        <a class="deadline-row" asp-controller="Vacancies" asp-action="Details" asp-route-id="@vacancy.Id">
                            <span><strong>@vacancy.Title</strong><span>@vacancy.Department</span></span>
                            <span class="deadline-days @(days <= 3 ? "urgent" : "")">@days дн.</span>
                        </a>
                    }
                    </div>
                }
            </section>
            <section class="panel quick-panel" aria-labelledby="quick-title">
                <div class="panel-header"><div><p class="panel-kicker">Действия</p><h2 id="quick-title">Быстрое добавление</h2></div></div>
                <div class="quick-links">
                    <a asp-controller="Resumes" asp-action="Create"><span>Новое резюме</span><span class="quick-plus">+</span></a>
                    <a asp-controller="Interviews" asp-action="Create"><span>Назначить собеседование</span><span class="quick-plus">+</span></a>
                    <a asp-controller="Candidates" asp-action="Create"><span>Новый кандидат</span><span class="quick-plus">+</span></a>
                </div>
            </section>
        </aside>
    </div>
    <section class="panel recent-panel" aria-labelledby="recent-title">
        <div class="panel-header">
            <div><p class="panel-kicker">Входящие отклики</p><h2 id="recent-title">Последние резюме</h2></div>
            <a asp-controller="Resumes" asp-action="Index" class="panel-link">Все резюме</a>
        </div>
        @if (Model.RecentResumes.Count == 0) {
            <div class="panel-empty"><p>Резюме пока не добавлены.</p><a asp-controller="Resumes" asp-action="Create" class="btn btn-outline-primary">Добавить резюме</a></div>
        } else {
            <div class="recent-list">
            @foreach (var resume in Model.RecentResumes) {
                <a class="recent-row" asp-controller="Resumes" asp-action="Details" asp-route-id="@resume.Id">
                    <span class="recent-person"><strong>@resume.Candidate.LastName @resume.Candidate.FirstName</strong><span>@(resume.Vacancy?.Title ?? "Без вакансии")</span></span>
                    <span class="recent-status">@Html.Raw(resume.Status.Pill())</span>
                    <time datetime="@resume.SubmittedAt.ToString("yyyy-MM-ddTHH:mm")">@resume.SubmittedAt.ToString("dd.MM.yyyy")</time>
                    <svg class="row-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            }
            </div>
        }
    </section>
} else {
    <section class="home-intro" aria-labelledby="home-title">
        <div>
            <p class="section-label">HRMS для команды найма</p>
            <h1 id="home-title">Весь процесс найма на одном рабочем столе</h1>
            <p class="home-lead">Ведите вакансии, отклики кандидатов и собеседования в единой системе. Руководители и рекрутеры видят актуальный статус работы.</p>
            <div class="landing-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Войти в рабочий стол</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary">Создать учётную запись</a>
            </div>
        </div>
        <div class="landing-note">
            <span class="landing-note-label">В системе</span>
            <ul><li>Карточки вакансий и зарплатные вилки</li><li>История резюме каждого кандидата</li><li>Участники и результаты собеседований</li><li>Отчёты по срокам и конверсии</li></ul>
        </div>
    </section>
    <nav class="home-directory" aria-label="Разделы кадрового учёта">
        <a class="directory-row" asp-controller="Vacancies" asp-action="Index"><span class="directory-index">01</span><span class="directory-copy"><strong>Вакансии</strong><span>Штатные единицы, зарплатные вилки и сроки приёма резюме.</span></span><span class="directory-action">Перейти к списку</span></a>
        <a class="directory-row" asp-controller="Candidates" asp-action="Index"><span class="directory-index">02</span><span class="directory-copy"><strong>Кандидаты</strong><span>Контактные данные, резюме и история откликов.</span></span><span class="directory-action">Открыть картотеку</span></a>
        <a class="directory-row" asp-controller="Interviews" asp-action="Index"><span class="directory-index">03</span><span class="directory-copy"><strong>Собеседования</strong><span>Даты, форматы, участники и результаты встреч.</span></span><span class="directory-action">Посмотреть расписание</span></a>
        <a class="directory-row" asp-controller="Reports" asp-action="ExpiringVacancies"><span class="directory-index">04</span><span class="directory-copy"><strong>Отчёты</strong><span>Сроки приёма откликов, профили кандидатов и итоги собеседований.</span></span><span class="directory-action">Открыть отчёты</span></a>
    </nav>
}
