@model IEnumerable<Hrms.Domain.Entities.Resume>
@{
    ViewData["Title"] = "Резюме";
    var hasFilters = !string.IsNullOrWhiteSpace(ViewBag.Search as string)
        || ViewBag.MinExperience is not null
        || !string.IsNullOrWhiteSpace(ViewBag.Skill as string)
        || ViewBag.MaxDesiredSalary is not null;
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Резюме</h1>
        <p class="page-description">Поиск по опыту, навыкам и зарплатным ожиданиям. У каждого кандидата одно резюме.</p>
    </div>
    <a asp-controller="Candidates" asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новый кандидат
    </a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр резюме">
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="resume-search">Поиск</label>
        <input id="resume-search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Имя, должность или навык" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="min-experience">Опыт от, лет</label>
        <input id="min-experience" name="minExperience" value="@ViewBag.MinExperience" class="form-control" type="number" min="0" max="60" inputmode="numeric" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="skill">Навык</label>
        <input id="skill" name="skill" value="@ViewBag.Skill" class="form-control" placeholder="Например, SQL" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="max-salary">Зарплата до, ₽</label>
        <input id="max-salary" name="maxDesiredSalary" value="@ViewBag.MaxDesiredSalary" class="form-control" type="number" min="0" step="0.01" inputmode="numeric" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (!Model.Any()) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>По фильтру ничего не нашлось</h2>
            <p>Попробуйте убрать навык или увеличить верхнюю границу зарплаты.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Резюме пока нет</h2>
            <p>Резюме создаётся вместе с кандидатом. Добавьте кандидата, чтобы начать поиск по навыкам и опыту.</p>
            <a asp-controller="Candidates" asp-action="Create" class="btn btn-primary">Добавить кандидата</a>
        }
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список резюме кандидатов</caption>
                <thead>
                    <tr><th>Кандидат</th><th>Должность</th><th>Опыт</th><th>Зарплата</th><th>Навыки</th><th>Связи</th><th class="text-end">Действия</th></tr>
                </thead>
                <tbody>
                @foreach (var resume in Model) {
                    <tr>
                        <td data-label="Кандидат">
                            <a asp-action="Details" asp-route-id="@resume.Id" class="text-decoration-none fw-semibold">@resume.Candidate.LastName @resume.Candidate.FirstName</a>
                            <span class="table-subtext">@resume.Candidate.Email</span>
                        </td>
                        <td data-label="Должность">@resume.Headline</td>
                        <td data-label="Опыт">@resume.ExperienceYears л.</td>
                        <td data-label="Зарплата" class="font-mono text-nowrap">@(resume.DesiredSalary?.ToString("N0") ?? "—") ₽</td>
                        <td data-label="Навыки">
                            @if (!string.IsNullOrWhiteSpace(resume.Details?.Skills)) {
                                <span class="skill-text" title="@resume.Details.Skills">@resume.Details.Skills</span>
                            } else {
                                <span class="text-muted">Не указаны</span>
                            }
                        </td>
                        <td data-label="Связи">
                            <span>@resume.Candidate.Applications.Count откл.</span>
                            <span class="table-subtext">@resume.VacancyMatches.Count в подборе</span>
                        </td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-secondary">Открыть</a>
                            <a asp-action="Edit" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
