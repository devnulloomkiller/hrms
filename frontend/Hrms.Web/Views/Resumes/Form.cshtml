@model Hrms.Domain.Entities.Resume
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? $"Изменить резюме #{Model.Id}" : "Новое резюме";
    var candidates = ViewBag.Candidates as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
    var vacancies = ViewBag.Vacancies as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-description">Свяжите отклик с кандидатом и при необходимости выберите вакансию.</p>
    </div>
</header>
<div class="card form-card">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CandidateId" class="form-label">Кандидат</label>
                <select asp-for="CandidateId" asp-items="candidates" class="form-select"></select>
                <span asp-validation-for="CandidateId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VacancyId" class="form-label">Вакансия</label>
                <select asp-for="VacancyId" asp-items="vacancies" class="form-select">
                    <option value="">Без вакансии</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="ExperienceYears" class="form-label">Опыт, лет</label>
                <input asp-for="ExperienceYears" class="form-control" />
                <span asp-validation-for="ExperienceYears" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="SubmittedAt" class="form-label">Дата подачи</label>
                <input asp-for="SubmittedAt" class="form-control" type="datetime-local" />
                <span asp-validation-for="SubmittedAt" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label">Статус</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<Hrms.Domain.Enums.ResumeStatus>()" class="form-select"></select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Summary" class="form-label">О кандидате</label>
            <textarea asp-for="Summary" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить резюме</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
