@model Hrms.Domain.Entities.Resume
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = $"Резюме: {Model.Candidate.LastName} {Model.Candidate.FirstName}";
    var applications = Model.Candidate.Applications.OrderByDescending(a => a.AppliedAt).ToList();
    var matches = Model.VacancyMatches.OrderByDescending(m => m.MatchScore).ToList();
    var safeFileUrl = Uri.TryCreate(Model.Details?.FilePath, UriKind.Absolute, out var fileUri)
        && (fileUri.Scheme == Uri.UriSchemeHttp || fileUri.Scheme == Uri.UriSchemeHttps)
        ? Model.Details.FilePath
        : null;
}
<header class="page-header">
    <div class="page-header-copy">
        <p class="section-label">Резюме</p>
        <h1 class="page-title">@Model.Candidate.LastName @Model.Candidate.FirstName</h1>
        <p class="page-description">@Model.Headline · @Model.ExperienceYears лет опыта</p>
    </div>
    <div class="page-header-actions">
        <a asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.CandidateId" class="btn btn-outline-secondary">Карточка кандидата</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Изменить</a>
        <a asp-controller="Candidates" asp-action="Match" asp-route-id="@Model.CandidateId" class="btn btn-primary">Подобрать вакансии</a>
    </div>
</header>

<div class="row g-3">
    <div class="col-lg-5">
        <section class="card detail-card h-100" aria-labelledby="resume-contacts">
            <h2 id="resume-contacts">Контакты</h2>
            <dl class="detail-list">
                <dt>Email</dt><dd><a href="mailto:@Model.Candidate.Email">@Model.Candidate.Email</a></dd>
                <dt>Телефон</dt><dd>@(string.IsNullOrWhiteSpace(Model.Candidate.Phone) ? "Не указан" : Model.Candidate.Phone)</dd>
                <dt>Желаемая зарплата</dt><dd>@(Model.DesiredSalary is { } salary ? $"{salary:N0} ₽" : "Не указана")</dd>
                <dt>Образование</dt><dd>@(string.IsNullOrWhiteSpace(Model.Details?.Education) ? "Не указано" : Model.Details.Education)</dd>
                <dt>Файл</dt>
                <dd>
                    @if (safeFileUrl is not null) {
                        <a href="@safeFileUrl" target="_blank" rel="noopener noreferrer">Открыть файл</a>
                    } else {
                        <span class="text-muted">Не приложен</span>
                    }
                </dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="card detail-card h-100" aria-labelledby="resume-summary">
            <h2 id="resume-summary">О кандидате</h2>
            <p>@Model.Summary</p>
            @if (!string.IsNullOrWhiteSpace(Model.Details?.Skills)) {
                <div class="skill-chips" aria-label="Навыки">
                    @foreach (var skill in Model.Details.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) {
                        <span class="skill-chip">@skill</span>
                    }
                </div>
            }
            <p class="text-muted small mb-0">Обновлено @Model.UpdatedAt.ToString("dd.MM.yyyy")</p>
        </section>
    </div>
</div>

<section class="mt-4" aria-labelledby="resume-applications">
    <div class="section-heading-row">
        <div>
            <h2 id="resume-applications">Отклики</h2>
            <p class="page-description">Вакансии, на которые кандидат уже откликнулся.</p>
        </div>
        <a asp-controller="Applications" asp-action="Create" asp-route-candidateId="@Model.CandidateId" class="btn btn-outline-secondary">Добавить отклик</a>
    </div>
    @if (applications.Count == 0) {
        <div class="empty-state mt-3">
            <h3>Откликов пока нет</h3>
            <p>Когда кандидат откликнется на вакансию, здесь появится этап и собеседования.</p>
        </div>
    } else {
        <div class="card table-card mt-3">
            <div class="table-wrap">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">Отклики кандидата @Model.Candidate.LastName @Model.Candidate.FirstName</caption>
                    <thead><tr><th>Вакансия</th><th>Этап</th><th>Дата отклика</th><th>Собеседования</th><th class="text-end">Действия</th></tr></thead>
                    <tbody>
                    @foreach (var application in applications) {
                        <tr>
                            <td>
                                <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@application.VacancyId" class="text-decoration-none fw-semibold">@application.Vacancy.Title</a>
                                <span class="table-subtext">@application.Vacancy.Department</span>
                            </td>
                            <td>@Html.Raw(application.Stage.Pill())</td>
                            <td class="font-mono text-nowrap">@application.AppliedAt.ToString("dd.MM.yyyy")</td>
                            <td>@application.Interviews.Count</td>
                            <td class="text-end"><a asp-controller="Applications" asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-outline-secondary">Изменить</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<section class="mt-4" aria-labelledby="resume-matches">
    <div class="section-heading-row">
        <div>
            <h2 id="resume-matches">Подобранные вакансии</h2>
            <p class="page-description">Вакансии, сохранённые в подборку для этого резюме.</p>
        </div>
        <a asp-controller="Candidates" asp-action="Match" asp-route-id="@Model.CandidateId" class="btn btn-outline-primary">Подобрать ещё</a>
    </div>
    @if (matches.Count == 0) {
        <div class="empty-state mt-3">
            <h3>В подборке пусто</h3>
            <p>Запустите подбор, чтобы увидеть открытые вакансии с высокой оценкой соответствия.</p>
        </div>
    } else {
        <div class="card table-card mt-3">
            <div class="table-wrap">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">Подобранные вакансии для резюме</caption>
                    <thead><tr><th>Вакансия</th><th>Статус вакансии</th><th>Подбор</th><th>Соответствие</th></tr></thead>
                    <tbody>
                    @foreach (var match in matches) {
                        <tr>
                            <td>
                                <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@match.VacancyId" class="text-decoration-none fw-semibold">@match.Vacancy.Title</a>
                                <span class="table-subtext">@match.Vacancy.Department</span>
                            </td>
                            <td>@Html.Raw(match.Vacancy.Status.Pill())</td>
                            <td>@Html.Raw(match.Status.Pill())</td>
                            <td><span class="score">@(match.MatchScore ?? 0)%</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<div class="form-actions">
    <a asp-action="Index" class="btn btn-outline-secondary">Вернуться к резюме</a>
</div>
