@model IEnumerable<Hrms.Domain.Entities.Candidate>
@using Hrms.Domain.Enums
@{
    ViewData["Title"] = "Кандидаты";
    var hasFilters = !string.IsNullOrWhiteSpace(ViewBag.Search as string)
        || ViewBag.MinExperience is not null
        || !string.IsNullOrWhiteSpace(ViewBag.Skill as string)
        || ViewBag.OnlyWithResume == true;
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Кандидаты</h1>
        <p class="page-description">Картотека людей: контакты, одно резюме и все отклики на вакансии.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Новый кандидат
    </a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр кандидатов">
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="candidate-search">Поиск</label>
        <input id="candidate-search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Имя, email или должность" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="min-experience">Опыт от, лет</label>
        <input id="min-experience" name="minExperience" value="@ViewBag.MinExperience" class="form-control" type="number" min="0" max="60" inputmode="numeric" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="skill">Навык</label>
        <input id="skill" name="skill" value="@ViewBag.Skill" class="form-control" placeholder="Например, EF Core" />
    </div>
    <label class="filter-check">
        <input type="checkbox" name="onlyWithResume" value="true" checked="@(ViewBag.OnlyWithResume == true)" />
        Только с резюме
    </label>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (!Model.Any()) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>По фильтру никого не нашлось</h2>
            <p>Попробуйте убрать навык или снизить требуемый опыт — возможно, подходящий кандидат уже есть в картотеке.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Картотека пуста</h2>
            <p>Добавьте первого кандидата вместе с резюме — после этого можно будет создавать отклики и подбирать вакансии.</p>
            <a asp-action="Create" class="btn btn-primary">Добавить кандидата</a>
        }
    </section>
} else {
    <div class="card table-card responsive-table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">Список кандидатов</caption>
                <thead>
                    <tr><th>Кандидат</th><th>Контакты</th><th>Опыт</th><th>Навыки</th><th>Отклики</th><th class="text-end">Действия</th></tr>
                </thead>
                <tbody>
                @foreach (var c in Model) {
                    var latestApplication = c.Applications.OrderByDescending(a => a.UpdatedAt).FirstOrDefault();
                    <tr>
                        <td data-label="Кандидат">
                            <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none fw-semibold">@c.LastName @c.FirstName</a>
                            <span class="table-subtext">@(c.Resume?.Headline ?? "Резюме не заполнено")</span>
                        </td>
                        <td data-label="Контакты">
                            <a href="mailto:@c.Email" class="table-subtext">@c.Email</a>
                            @if (!string.IsNullOrWhiteSpace(c.Phone)) {
                                <span class="table-subtext">@c.Phone</span>
                            }
                        </td>
                        <td data-label="Опыт">@(c.Resume is null ? "—" : $"{c.Resume.ExperienceYears} л.")</td>
                        <td data-label="Навыки">
                            @if (!string.IsNullOrWhiteSpace(c.Resume?.Details?.Skills)) {
                                <span class="skill-text" title="@c.Resume.Details.Skills">@c.Resume.Details.Skills</span>
                            } else {
                                <span class="text-muted">Не указаны</span>
                            }
                        </td>
                        <td data-label="Отклики">
                            @if (c.Applications.Count == 0) {
                                <span class="text-muted">Нет</span>
                            } else {
                                <span>@c.Applications.Count</span>
                                @if (latestApplication is not null) {
                                    @Html.Raw(latestApplication.Stage.Pill())
                                }
                            }
                        </td>
                        <td data-label="Действия" class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Открыть</a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
