@model List<Hrms.Application.DTOs.VacancyMatchDto>
@using Hrms.Domain.Enums
@{
    var candidate = (Hrms.Domain.Entities.Candidate)ViewBag.Candidate;
    ViewData["Title"] = $"Подбор вакансий: {candidate.LastName} {candidate.FirstName}";
    var search = ViewBag.Search as string;
    var onlyOpen = ViewBag.OnlyOpen == true;
    var onlyNotLinked = ViewBag.OnlyNotLinked == true;
    var hasFilters = !string.IsNullOrWhiteSpace(search) || !onlyOpen || !onlyNotLinked;
}
<header class="page-header">
    <div class="page-header-copy">
        <p class="section-label">Подбор</p>
        <h1 class="page-title">Вакансии для @candidate.LastName @candidate.FirstName</h1>
        <p class="page-description">@candidate.Resume?.Headline · @candidate.Resume?.ExperienceYears лет опыта. Отметьте вакансии, которые стоит предложить кандидату.</p>
    </div>
    <a asp-action="Details" asp-route-id="@candidate.Id" class="btn btn-outline-secondary">К карточке кандидата</a>
</header>

<form method="get" class="filter-bar" role="search" aria-label="Фильтр вакансий для подбора">
    <div class="filter-field filter-field-wide">
        <label class="form-label" for="vacancy-search">Название или отдел</label>
        <input id="vacancy-search" name="search" value="@search" class="form-control" placeholder="Например, .NET или Разработка" />
    </div>
    <label class="filter-check">
        <input type="checkbox" name="onlyOpen" value="true" checked="@onlyOpen" />
        Только открытые
    </label>
    <label class="filter-check">
        <input type="checkbox" name="onlyNotLinked" value="true" checked="@onlyNotLinked" />
        Скрыть уже связанные
    </label>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Match" asp-route-id="@candidate.Id" class="btn btn-link">Сбросить</a>
    </div>
</form>

<p class="form-hint">Оценка считается по трём критериям: опыт (40), совпадение обязательных навыков (40) и попадание желаемой зарплаты в вилку вакансии (20).</p>

@if (Model.Count == 0) {
    <section class="empty-state">
        @if (hasFilters) {
            <h2>Подходящих вакансий не нашлось</h2>
            <p>Попробуйте включить закрытые вакансии или скрыть меньше связей — возможно, подходящая позиция уже есть.</p>
            <a asp-action="Match" asp-route-id="@candidate.Id" class="btn btn-outline-secondary">Сбросить фильтры</a>
        } else {
            <h2>Вакансий пока нет</h2>
            <p>Сначала создайте вакансию — после этого здесь появится подбор по опыту, навыкам и зарплате.</p>
            <a asp-controller="Vacancies" asp-action="Create" class="btn btn-primary">Создать вакансию</a>
        }
    </section>
} else {
    <form asp-action="Match" method="post">
        <input type="hidden" name="id" value="@candidate.Id" />
        <div class="card table-card responsive-table-card">
            <div class="table-wrap">
                <table class="table table-hover align-middle responsive-table">
                    <caption class="visually-hidden">Вакансии, подходящие кандидату</caption>
                    <thead>
                        <tr><th class="check-column"><span class="visually-hidden">Выбрать</span></th><th>Вакансия</th><th>Статус</th><th>Опыт</th><th>Зарплата</th><th>Соответствие</th><th>Связь</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var vacancy in Model) {
                        <tr>
                            <td class="check-column" data-label="Выбрать">
                                @if (!vacancy.IsLinked) {
                                    <input type="checkbox" name="vacancyIds" value="@vacancy.VacancyId" aria-label="Выбрать вакансию @vacancy.Title" />
                                } else {
                                    <span class="text-muted" aria-label="Уже связана">—</span>
                                }
                            </td>
                            <td data-label="Вакансия">
                                <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@vacancy.VacancyId" class="text-decoration-none fw-semibold">@vacancy.Title</a>
                                <span class="table-subtext">@vacancy.Department</span>
                            </td>
                            <td data-label="Статус">@Html.Raw(vacancy.Status.Pill())</td>
                            <td data-label="Опыт">от @vacancy.MinExperience л.</td>
                            <td data-label="Зарплата" class="font-mono text-nowrap">@vacancy.SalaryMin.ToString("N0")–@(vacancy.SalaryMax?.ToString("N0") ?? "…") ₽</td>
                            <td data-label="Соответствие">
                                <div class="score-cell">
                                    <span class="score">@vacancy.MatchScore%</span>
                                    <span class="score-meter" aria-hidden="true"><span style="width:@vacancy.MatchScore%"></span></span>
                                </div>
                            </td>
                            <td data-label="Связь">
                                @if (vacancy.ApplicationStage is { } stage) {
                                    @Html.Raw(stage.Pill())
                                } else if (vacancy.LinkStatus is { } linkStatus) {
                                    @Html.Raw(linkStatus.Pill())
                                } else {
                                    <span class="text-muted">Не связана</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="form-actions">
            <div class="filter-field">
                <label class="form-label" for="match-status">Статус подбора</label>
                <select id="match-status" name="status" class="form-select">
                    <option value="@MatchStatus.Suggested">Предложен</option>
                    <option value="@MatchStatus.Shortlisted">Шортлист</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Добавить выбранные в подборку</button>
            <a asp-action="Details" asp-route-id="@candidate.Id" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
}
