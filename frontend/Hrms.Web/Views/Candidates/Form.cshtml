@model CandidateFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? $"Изменить: {Model.LastName} {Model.FirstName}" : "Новый кандидат";
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-description">Контактные данные и одно резюме кандидата. Отклики на вакансии добавляются отдельно.</p>
    </div>
</header>

<div class="card form-card">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <fieldset class="form-section">
            <legend class="form-section-title">Контактные данные</legend>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label">Фамилия</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label">Имя</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label">Телефон</label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="form-section">
            <legend class="form-section-title">Резюме</legend>
            <p class="form-hint">Резюме хранится в единственном экземпляре и принадлежит кандидату. Его можно подобрать к нескольким вакансиям.</p>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Headline" class="form-label">Желаемая должность</label>
                    <input asp-for="Headline" class="form-control" placeholder="Например, Senior .NET Developer" />
                    <span asp-validation-for="Headline" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ExperienceYears" class="form-label">Опыт, лет</label>
                    <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="60" inputmode="numeric" />
                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DesiredSalary" class="form-label">Желаемая зарплата, ₽</label>
                    <input asp-for="DesiredSalary" class="form-control" type="number" min="0" step="0.01" inputmode="numeric" />
                    <span asp-validation-for="DesiredSalary" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FilePath" class="form-label">Ссылка на файл резюме</label>
                    <input asp-for="FilePath" class="form-control" placeholder="https://…" />
                    <span asp-validation-for="FilePath" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Skills" class="form-label">Навыки</label>
                <input asp-for="Skills" class="form-control" placeholder="C#, ASP.NET Core, EF Core, SQL" />
                <span class="form-hint">Через запятую. Навыки участвуют в оценке соответствия вакансиям.</span>
                <span asp-validation-for="Skills" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Education" class="form-label">Образование</label>
                <input asp-for="Education" class="form-control" placeholder="Вуз, специальность, год выпуска" />
                <span asp-validation-for="Education" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="form-label">О кандидате</label>
                <textarea asp-for="Summary" class="form-control" rows="5" placeholder="Опыт, сильные стороны, что важно в новой роли"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить кандидата</button>
            @if (isEdit) {
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
            } else {
                <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
            }
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
