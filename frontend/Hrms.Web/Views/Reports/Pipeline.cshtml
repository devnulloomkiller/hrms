@model List<Hrms.Application.DTOs.VacancyPipelineDto>
@{
    ViewData["Title"] = "Воронка по вакансиям";
}
<header class="page-header">
    <div class="page-header-copy">
        <h1 class="page-title">Воронка по вакансиям</h1>
        <p class="page-description">Сколько откликов на каждом этапе и какая доля доходит до найма.</p>
    </div>
</header>
<partial name="_ReportNavigation" />
@if (Model.Count == 0) {
    <section class="empty-state">
        <h2>Данных для воронки нет</h2>
        <p>Создайте вакансии и отклики — после этого отчёт покажет этапы и конверсию.</p>
        <a asp-controller="Applications" asp-action="Create" class="btn btn-primary">Добавить отклик</a>
    </section>
} else {
    <div class="card table-card">
        <div class="table-wrap">
            <table class="table table-hover align-middle">
                <caption class="visually-hidden">Воронка откликов по вакансиям</caption>
                <thead>
                    <tr><th>Вакансия</th><th>Отдел</th><th>Всего</th><th>Новые</th><th>Скрининг</th><th>Собеседования</th><th>Оффер</th><th>Наняты</th><th>Отказы</th><th>Конверсия</th></tr>
                </thead>
                <tbody>
                @foreach (var vacancy in Model) {
                    var conversion = vacancy.TotalApplications == 0 ? "—" : $"{(double)vacancy.Hired / vacancy.TotalApplications:P0}";
                    <tr>
                        <td><a asp-controller="Vacancies" asp-action="Details" asp-route-id="@vacancy.VacancyId" class="text-decoration-none fw-semibold">@vacancy.Title</a></td>
                        <td class="text-muted">@vacancy.Department</td>
                        <td><strong>@vacancy.TotalApplications</strong></td>
                        <td>@vacancy.Applied</td>
                        <td>@vacancy.Screening</td>
                        <td>@vacancy.Interview</td>
                        <td>@vacancy.Offer</td>
                        <td>@vacancy.Hired</td>
                        <td class="text-muted">@(vacancy.Rejected + vacancy.Withdrawn)</td>
                        <td>@conversion</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
